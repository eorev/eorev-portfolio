# PostHog — copy to .env.local and fill in.
# Project API key: PostHog -> Settings -> Project -> Project API key.
# It starts with "phc_" and is safe to expose in the browser bundle (it is
# write-only; it cannot read your analytics data).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here

# "us" (default) or "eu" — must match the cloud region you signed up for, or
# events will be sent to a region that has never heard of your project.
NEXT_PUBLIC_POSTHOG_REGION=us

# The PostHog dashboard URL for your region. Used only for toolbar deep links.
#   US -> https://us.posthog.com
#   EU -> https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
